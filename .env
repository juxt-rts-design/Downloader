# Local (PC) : 0.0.0.0:80 — VPS (nginx Hexaro) : 127.0.0.1:3002
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=80

# CORS
ALLOWED_ORIGINS=*

# YouTube (anti-bot VPS) — cookies Netscape montés dans le container
YTDLP_CLIENTS=android,ios,tv,mweb,web
YTDLP_COOKIES=/cookies/youtube.txt
YTDLP_COOKIES_HOST=./Backend_tiktok/cookies
