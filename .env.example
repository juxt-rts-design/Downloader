# En local : 80. Sur le VPS (nginx Hexaro) : 3002
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=80

# CORS : * = toutes origines (VPS / IP publique)
ALLOWED_ORIGINS=*

# YouTube sur VPS = IP datacenter → anti-bot
# Option A — cookies (léger, recommandé sur petit VPS) :
YTDLP_CLIENTS=android,ios,tv,mweb,web
# YTDLP_COOKIES=/cookies/youtube.txt
# YTDLP_COOKIES_HOST=./Backend_tiktok/cookies
#
# Option B — session Cobalt (Chromium ~1 Go RAM) :
# docker compose --profile yt up -d
# YOUTUBE_SESSION_SERVER=http://yt-session-generator:8080/
# YOUTUBE_SESSION_INNERTUBE_CLIENT=WEB_EMBEDDED
