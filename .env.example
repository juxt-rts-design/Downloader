# En local : 80. Sur le VPS (nginx Hexaro) : 3002
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=80

# CORS : * = toutes origines (VPS / IP publique)
ALLOWED_ORIGINS=*

# YouTube (IP VPS souvent bloquée / 429) :
# clients yt-dlp à tenter dans l’ordre
YTDLP_CLIENTS=android,ios,tv,mweb,web
# Fichier cookies Netscape (export depuis le navigateur) monté dans le container
# YTDLP_COOKIES=/cookies/youtube.txt
# YTDLP_COOKIES_HOST=./Backend_tiktok/cookies
