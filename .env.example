# En local : 80. Sur le VPS (nginx Hexaro) : 3002
PUBLIC_BIND=0.0.0.0
PUBLIC_PORT=80

# CORS : * = toutes origines (VPS / IP publique)
ALLOWED_ORIGINS=*

# YouTube sur VPS = IP datacenter → anti-bot (« Sign in to confirm you’re not a bot »)
# 1) docker-compose lance déjà yt-session-generator pour Cobalt (poToken)
# 2) Si ça ne suffit pas, cookies Netscape :
YTDLP_CLIENTS=android,ios,tv,mweb,web
# YTDLP_COOKIES=/cookies/youtube.txt
# YTDLP_COOKIES_HOST=./Backend_tiktok/cookies
